<Window x:Class="WinmailDatReader.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WinmailDatReader.App"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="{Binding WindowTitle}"
        Width="1100" Height="720" MinWidth="640" MinHeight="400"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveAttachmentCommand}" />
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding SaveAllAttachmentsCommand}" />
    </Window.InputBindings>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Datei">
                <MenuItem Header="Ö_ffnen…" InputGestureText="Strg+O" Command="{Binding OpenCommand}" />
                <MenuItem Header="_Nachrichtentext speichern…" Command="{Binding SaveBodyCommand}" />
                <Separator />
                <MenuItem Header="_Beenden" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="_Anhänge">
                <MenuItem Header="_Speichern unter…" InputGestureText="Strg+S" Command="{Binding SaveAttachmentCommand}" />
                <MenuItem Header="_Alle Anhänge speichern…" InputGestureText="Strg+Umschalt+S" Command="{Binding SaveAllAttachmentsCommand}" />
            </MenuItem>
        </Menu>

        <ToolBar DockPanel.Dock="Top" ToolBarTray.IsLocked="True">
            <Button Content="Öffnen…" Command="{Binding OpenCommand}" Padding="8,2" />
            <Separator />
            <Button Content="Anhang speichern unter…" Command="{Binding SaveAttachmentCommand}" Padding="8,2" />
            <Button Content="Alle Anhänge speichern…" Command="{Binding SaveAllAttachmentsCommand}" Padding="8,2" />
            <Separator />
            <Button Content="Nachrichtentext speichern…" Command="{Binding SaveBodyCommand}" Padding="8,2" />
        </ToolBar>

        <Grid>
            <!-- Startzustand -->
            <TextBlock Text="Eine winmail.dat über „Öffnen…“ auswählen oder hierher ziehen."
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="16" Foreground="Gray"
                       Visibility="{Binding IsLoaded, Converter={StaticResource InverseBoolToVis}}" />

            <Grid Margin="8" Visibility="{Binding IsLoaded, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Metadaten -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="Margin" Value="0,1,12,1" />
                        </Style>
                        <Style TargetType="TextBox">
                            <Setter Property="IsReadOnly" Value="True" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Margin" Value="0,1" />
                        </Style>
                    </Grid.Resources>
                    <TextBlock Grid.Row="0" Text="Betreff:" FontWeight="SemiBold" />
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SubjectText, Mode=OneWay}" FontWeight="SemiBold" FontSize="14" />
                    <TextBlock Grid.Row="1" Text="Von:" />
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SenderText, Mode=OneWay}" />
                    <TextBlock Grid.Row="2" Text="Datum:" />
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding DateText, Mode=OneWay}" />
                    <TextBlock Grid.Row="3" Text="Datei:" />
                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding FilePath, Mode=OneWay}" Foreground="Gray" />
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="200" />
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="320" MinWidth="180" />
                    </Grid.ColumnDefinitions>

                    <!-- Nachrichtentext -->
                    <Border Grid.Column="0" BorderBrush="#FFCCCCCC" BorderThickness="1">
                        <DockPanel>
                            <TextBlock x:Name="BodyHint" DockPanel.Dock="Top" Padding="6,3" Background="#FFFFF4CE"
                                       TextWrapping="Wrap" Visibility="Collapsed" />
                            <Grid>
                                <wv2:WebView2 x:Name="HtmlView" Visibility="Collapsed" />
                                <RichTextBox x:Name="RtfView" IsReadOnly="True" IsDocumentEnabled="True" Visibility="Collapsed"
                                             VerticalScrollBarVisibility="Auto" BorderThickness="0" Padding="4" />
                                <TextBox x:Name="TextView" IsReadOnly="True" Visibility="Collapsed" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                         BorderThickness="0" Padding="4" FontFamily="Consolas" />
                                <TextBlock x:Name="NoBodyText" Text="Kein Nachrichtentext vorhanden"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Gray"
                                           Visibility="Collapsed" />
                            </Grid>
                        </DockPanel>
                    </Border>

                    <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext" />

                    <!-- Anhänge -->
                    <DockPanel Grid.Column="2">
                        <TextBlock DockPanel.Dock="Top" Text="{Binding AttachmentsHeader}" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="Speichern unter…" Command="{Binding SaveAttachmentCommand}" Padding="8,3" Margin="0,0,6,0" />
                            <Button Content="Alle speichern…" Command="{Binding SaveAllAttachmentsCommand}" Padding="8,3" />
                        </StackPanel>
                        <Grid>
                            <ListView ItemsSource="{Binding Attachments}" SelectedItem="{Binding SelectedAttachment}"
                                      SelectionMode="Single"
                                      Visibility="{Binding HasAttachments, Converter={StaticResource BoolToVis}}">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <EventSetter Event="MouseDoubleClick" Handler="Attachment_DoubleClick" />
                                        <Setter Property="ToolTip" Value="Doppelklick zum Speichern" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Name" Width="200" DisplayMemberBinding="{Binding Name}" />
                                        <GridViewColumn Header="Größe" Width="80">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding SizeText}" TextAlignment="Right" MinWidth="60" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                            <TextBlock Text="Keine Anhänge" Foreground="Gray" HorizontalAlignment="Center" Margin="0,20,0,0"
                                       Visibility="{Binding HasAttachments, Converter={StaticResource InverseBoolToVis}}" />
                        </Grid>
                    </DockPanel>
                </Grid>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
